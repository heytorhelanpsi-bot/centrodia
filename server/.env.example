NODE_ENV=development
PORT=3000
# Papel da aplicação (sem privilégios de dono; sujeito a RLS)
DATABASE_URL=postgres://reabilita_app:SENHA@localhost:5432/reabilita
# Papel proprietário (somente migrações)
MIGRATION_DATABASE_URL=postgres://reabilita_owner:SENHA@localhost:5432/reabilita
APP_DB_ROLE=reabilita_app
# 32 bytes em base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
# IA opcional (somente no backend). Relatórios automáticos funcionam sem IA.
# AI_PROVIDER: gemini | anthropic | vazio (usa o provedor cuja chave estiver definida)
AI_PROVIDER=
AI_ENABLED=true
# Google Gemini — chave criada em https://aistudio.google.com (projeto com faturamento ativo)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
COOKIE_SECURE=false
TRUST_PROXY=false
PUBLIC_URL=http://localhost:5173
